# Copy to .env and adjust values for your environment.

NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sehatdoc?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Dev OTP: accept this code when OTP_DEV_MODE=true (never enable in production)
OTP_DEV_MODE=true
OTP_DEV_CODE="123456"
OTP_EXPIRES_MINUTES=10

# Slot hold while awaiting payment / payment proof
PAYMENT_HOLD_MINUTES=30

CORS_ORIGIN="http://localhost:3000"

# Optional SehtDesk (SehatDoc clinic SaaS) sync — leave empty if unused.
# When a doctor enables sehatdocSyncEnabled + booking slug, confirmed
# marketplace bookings are POSTed to {SEHATDOC_API_URL}/api/booking/{slug}.
SEHATDOC_API_URL="http://localhost:5001"
SEHATDOC_OUTBOX_ENABLED=true
SEHATDOC_OUTBOX_INTERVAL_MS=10000
