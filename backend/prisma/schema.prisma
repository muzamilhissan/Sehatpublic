// Sehatdoc — scalable PostgreSQL schema (Prisma)
// Marketplace: free doctor onboarding + verification · hospitals · labs · online consults
//
// v1 product scope (locked):
// - Family booking: YES (patient_dependents)
// - Chat / pharmacy / insurance / gateway APIs: NOT in v1
// - Payments v1: CASH or MANUAL_TRANSFER (show account → patient pays → upload screenshot proof)
// - Commission / wallets / payouts: tables kept for later; not used in v1 booking flow
//
// Scale notes:
// - Soft deletes (deleted_at) on public entities — never hard-delete booked history
// - Fee snapshots on every order line — never re-read live prices after booking
// - Payment holds via appointments.payment_expires_at + status EXPIRED
// - Partial unique slot index is in prisma/migrations/manual/partial_indexes.sql
// - Heavy tables indexed for time-range queries; safe to partition later by created_at

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AppRole {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  LAB_ADMIN
  PLATFORM_ADMIN
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HospitalType {
  HOSPITAL
  CLINIC
  MEDICAL_CENTER
}

enum EmploymentType {
  FULL_TIME
  VISITING
  CONSULTANT
}

enum OrgAdminRole {
  OWNER
  MANAGER
  STAFF
}

enum AvailabilityMode {
  ONLINE
  CLINIC
  BOTH
}

enum AppointmentMode {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED // payment hold timed out
  RESCHEDULED
}

/// Opt-in SehtDesk sync status (marketplace booking never depends on Desk)
enum DeskSyncStatus {
  NOT_LINKED
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum CancelledBy {
  PATIENT
  DOCTOR
  SYSTEM
  ADMIN
}

enum ConsultationStatus {
  WAITING
  LIVE
  ENDED
  FAILED
}

enum VideoProvider {
  AGORA
  TWILIO
  DAILY
  CUSTOM
}

enum CollectionType {
  HOME
  WALK_IN
}

enum LabOrderStatus {
  PENDING_PAYMENT
  BOOKED
  SAMPLE_COLLECTED
  PROCESSING
  REPORTED
  CANCELLED
  EXPIRED
}

enum PayableType {
  APPOINTMENT
  LAB_ORDER
}

/// How the patient settles in v1 (+ future gateway hooks)
enum PaymentMethod {
  CASH // pay at clinic / on visit / collect later
  MANUAL_TRANSFER // platform account shown; patient uploads screenshot
  // ── future (not wired in v1) ──
  JAZZCASH
  EASYPAISA
  CARD
  WALLET
}

enum PaymentAccountChannel {
  BANK
  JAZZCASH
  EASYPAISA
  OTHER
}

enum PaymentStatus {
  INITIATED
  AWAITING_PROOF // MANUAL_TRANSFER: waiting for screenshot
  PENDING_VERIFICATION // screenshot uploaded; admin/staff review
  PAID // verified OR cash accepted
  PROOF_REJECTED // ask patient to re-upload
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentProofStatus {
  UPLOADED
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum LedgerEntryType {
  CONSULTATION_EARNING
  LAB_EARNING
  PLATFORM_COMMISSION
  PAYOUT
  REFUND
  ADJUSTMENT
  PROMO_SUBSIDY
}

enum LedgerOwnerType {
  DOCTOR
  HOSPITAL
  LAB
  PLATFORM
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
}

enum ReviewTargetType {
  DOCTOR
  HOSPITAL
  LAB
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum DocumentType {
  PMC_CERTIFICATE
  CNIC_FRONT
  CNIC_BACK
  DEGREE
  EXPERIENCE_LETTER
  HOSPITAL_LICENSE
  LAB_LICENSE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MediaPurpose {
  AVATAR
  DOCUMENT
  REPORT
  PRESCRIPTION_PDF
  OTHER
}

enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SampleType {
  BLOOD
  URINE
  STOOL
  SWAB
  IMAGING
  OTHER
}

enum DependentRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponAppliesTo {
  ALL
  APPOINTMENT
  LAB_ORDER
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

// ─── Geo ─────────────────────────────────────────────────────────────────────

model City {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  areas           Area[]
  patients        Patient[]
  doctors         Doctor[]
  hospitals       Hospital[]
  labs            Lab[]
  patientAddresses PatientAddress[]

  @@index([isActive])
  @@map("cities")
}

model Area {
  id        String    @id @default(uuid()) @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(100)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  city             City             @relation(fields: [cityId], references: [id])
  doctorClinics    DoctorClinic[]
  hospitals        Hospital[]
  labBranches      LabBranch[]
  patientAddresses PatientAddress[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@map("areas")
}

// ─── Identity & Auth ─────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(150)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  locale       String     @default("en") @db.VarChar(10)
  timezone     String     @default("Asia/Karachi") @db.VarChar(64)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz()
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  roles              UserRole[]
  patient            Patient?
  doctor             Doctor?
  refreshTokens      RefreshToken[]
  otpChallenges      OtpChallenge[]
  devices            UserDevice[]
  hospitalAdmins     HospitalAdmin[]
  labAdmins          LabAdmin[]
  payments              Payment[]                @relation("PaymentPayer")
  reviewedPaymentProofs PaymentProof[]           @relation("PaymentProofReviewer")
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  auditLogs             AuditLog[]               @relation("AuditActor")
  verifiedDoctors       Doctor[]                 @relation("DoctorVerifier")
  verifiedHospitals     Hospital[]               @relation("HospitalVerifier")
  verifiedLabs          Lab[]                    @relation("LabVerifier")
  mediaFiles            MediaFile[]
  moderatedReviews      Review[]                 @relation("ReviewModerator")
  // future: commission payouts
  payoutAccounts        PayoutAccount[]
  couponRedemptions     CouponRedemption[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       AppRole
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  attemptCount Int     @default(0) @map("attempt_count")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  deviceId  String?   @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  platform  String   @db.VarChar(20) // ios | android | web
  pushToken String?  @map("push_token") @db.VarChar(500)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, pushToken])
  @@map("user_devices")
}

// ─── Patients ────────────────────────────────────────────────────────────────

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender?
  bloodGroup  String?   @map("blood_group") @db.VarChar(5)
  cnic        String?   @unique @db.VarChar(15)
  cityId      String?   @map("city_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  city         City?              @relation(fields: [cityId], references: [id])
  addresses    PatientAddress[]
  dependents   PatientDependent[]
  allergies    PatientAllergy[]
  appointments Appointment[]
  labOrders    LabOrder[]
  reviews      Review[]
  favorites    FavoriteDoctor[]

  @@index([cityId])
  @@map("patients")
}

/// Book for family members without separate logins
model PatientDependent {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  fullName    String            @map("full_name") @db.VarChar(150)
  relation    DependentRelation @default(OTHER)
  dateOfBirth DateTime?         @map("date_of_birth") @db.Date
  gender      Gender?
  bloodGroup  String?           @map("blood_group") @db.VarChar(5)
  cnic        String?           @db.VarChar(15)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  labOrders    LabOrder[]

  @@index([patientId])
  @@map("patient_dependents")
}

model PatientAddress {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  label        String   @default("Home") @db.VarChar(50)
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  areaId       String?  @map("area_id") @db.Uuid
  cityId       String   @map("city_id") @db.Uuid
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  area    Area?   @relation(fields: [areaId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])

  @@index([patientId])
  @@map("patient_addresses")
}

model PatientAllergy {
  id        String          @id @default(uuid()) @db.Uuid
  patientId String          @map("patient_id") @db.Uuid
  name      String          @db.VarChar(150)
  severity  AllergySeverity @default(MILD)
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

model FavoriteDoctor {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("favorite_doctors")
}

// ─── Doctors ─────────────────────────────────────────────────────────────────

model Specialty {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  iconUrl     String?   @map("icon_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  doctorSpecialties DoctorSpecialty[]

  @@index([isActive, sortOrder])
  @@map("specialties")
}

model Doctor {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  pmcNumber           String?            @unique @map("pmc_number") @db.VarChar(50)
  title               String             @default("Dr") @db.VarChar(20)
  bio                 String?            @db.Text
  yearsExperience     Int                @default(0) @map("years_experience")
  consultationFee     Decimal            @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  followupFee         Decimal?           @map("followup_fee") @db.Decimal(12, 2)
  currency            String             @default("PKR") @db.VarChar(3)
  timezone            String             @default("Asia/Karachi") @db.VarChar(64)
  avgRating           Decimal            @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount         Int                @default(0) @map("review_count")
  completedConsults   Int                @default(0) @map("completed_consults")
  nextAvailableAt     DateTime?          @map("next_available_at") @db.Timestamptz() // denorm for search
  verificationStatus  VerificationStatus @default(DRAFT) @map("verification_status")
  verifiedAt          DateTime?          @map("verified_at") @db.Timestamptz()
  verifiedById        String?            @map("verified_by") @db.Uuid
  rejectionReason     String?            @map("rejection_reason") @db.Text
  isAcceptingPatients Boolean            @default(false) @map("is_accepting_patients")
  cityId              String?            @map("city_id") @db.Uuid
  // Cancellation: hours before slot when patient can cancel free
  freeCancelHours     Int                @default(2) @map("free_cancel_hours")
  /// Opt-in SehtDesk / SehatDoc clinic calendar sync (null = marketplace-only doctor)
  sehatdocBookingSlug   String?  @unique @map("sehatdoc_booking_slug") @db.VarChar(100)
  sehatdocDoctorUserId  String?  @map("sehatdoc_doctor_user_id") @db.Uuid
  sehatdocClinicId      String?  @map("sehatdoc_clinic_id") @db.Uuid
  sehatdocSyncEnabled   Boolean  @default(false) @map("sehatdoc_sync_enabled")
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz()
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  user            User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy      User?                          @relation("DoctorVerifier", fields: [verifiedById], references: [id])
  city            City?                          @relation(fields: [cityId], references: [id])
  specialties     DoctorSpecialty[]
  documents       DoctorDocument[]
  educations      DoctorEducation[]
  experiences     DoctorExperience[]
  languages       DoctorLanguage[]
  clinics         DoctorClinic[]
  availabilities  DoctorAvailability[]
  exceptions      DoctorAvailabilityException[]
  hospitalDoctors HospitalDoctor[]
  appointments    Appointment[]
  favorites       FavoriteDoctor[]
  wallet          Wallet?
  payoutAccounts  PayoutAccount[]

  // Search: approved + accepting + city
  @@index([verificationStatus, isAcceptingPatients, cityId])
  @@index([cityId, avgRating])
  @@index([nextAvailableAt])
  @@map("doctors")
}

model DoctorSpecialty {
  id          String  @id @default(uuid()) @db.Uuid
  doctorId    String  @map("doctor_id") @db.Uuid
  specialtyId String  @map("specialty_id") @db.Uuid
  isPrimary   Boolean @default(false) @map("is_primary")

  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@unique([doctorId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

model DoctorDocument {
  id         String         @id @default(uuid()) @db.Uuid
  doctorId   String         @map("doctor_id") @db.Uuid
  type       DocumentType
  status     DocumentStatus @default(UPLOADED)
  storageKey String         @map("storage_key") @db.VarChar(500)
  fileName   String         @map("file_name") @db.VarChar(255)
  mimeType   String         @map("mime_type") @db.VarChar(100)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, type])
  @@map("doctor_documents")
}

model DoctorEducation {
  id        String @id @default(uuid()) @db.Uuid
  doctorId  String @map("doctor_id") @db.Uuid
  degree    String @db.VarChar(150)
  institute String @db.VarChar(200)
  yearFrom  Int?   @map("year_from")
  yearTo    Int?   @map("year_to")
  sortOrder Int    @default(0) @map("sort_order")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_educations")
}

model DoctorExperience {
  id           String    @id @default(uuid()) @db.Uuid
  doctorId     String    @map("doctor_id") @db.Uuid
  organization String    @db.VarChar(200)
  roleTitle    String    @map("role_title") @db.VarChar(150)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isCurrent    Boolean   @default(false) @map("is_current")
  description  String?   @db.Text

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_experiences")
}

model DoctorLanguage {
  id       String @id @default(uuid()) @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  language String @db.VarChar(50)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, language])
  @@map("doctor_languages")
}

model DoctorClinic {
  id        String    @id @default(uuid()) @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  name      String    @db.VarChar(200)
  address   String    @db.Text
  areaId    String?   @map("area_id") @db.Uuid
  phone     String?   @db.VarChar(20)
  fee       Decimal?  @db.Decimal(12, 2)
  lat       Decimal?  @db.Decimal(10, 7)
  lng       Decimal?  @db.Decimal(10, 7)
  timezone  String    @default("Asia/Karachi") @db.VarChar(64)
  isPrimary Boolean   @default(false) @map("is_primary")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  area         Area?         @relation(fields: [areaId], references: [id])
  appointments Appointment[]

  @@index([doctorId])
  @@map("doctor_clinics")
}

model DoctorAvailability {
  id          String           @id @default(uuid()) @db.Uuid
  doctorId    String           @map("doctor_id") @db.Uuid
  dayOfWeek   Int              @map("day_of_week") // 0=Sun … 6=Sat
  startTime   String           @map("start_time") @db.VarChar(5) // local HH:mm
  endTime     String           @map("end_time") @db.VarChar(5)
  slotMinutes Int              @default(15) @map("slot_minutes")
  mode        AvailabilityMode @default(ONLINE)
  clinicId    String?          @map("clinic_id") @db.Uuid
  isActive    Boolean          @default(true) @map("is_active")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
  @@map("doctor_availabilities")
}

model DoctorAvailabilityException {
  id        String  @id @default(uuid()) @db.Uuid
  doctorId  String  @map("doctor_id") @db.Uuid
  date      DateTime @db.Date
  isOff     Boolean @default(true) @map("is_off")
  startTime String? @map("start_time") @db.VarChar(5)
  endTime   String? @map("end_time") @db.VarChar(5)
  reason    String? @db.VarChar(255)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
