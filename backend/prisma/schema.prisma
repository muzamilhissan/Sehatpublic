// ─── Payments (v1: cash + manual transfer + screenshot proof) ────────────────
//
// Flow — CASH:
//   book → Payment(method=CASH, status=PAID or INITIATED) → appointment CONFIRMED
//   (cash collected at clinic / visit; mark PAID when staff confirms if needed)
//
// Flow — MANUAL_TRANSFER:
//   book → show active PaymentInstruction → Payment(AWAITING_PROOF)
//   → patient uploads PaymentProof → PENDING_VERIFICATION
//   → admin APPROVES proof → Payment PAID → appointment/lab_order CONFIRMED
//   → or REJECTS → PROOF_REJECTED → patient re-uploads

/// Accounts patients transfer into (JazzCash / bank / EasyPaisa numbers)
model PaymentInstruction {
  id            String                @id @default(uuid()) @db.Uuid
  channel       PaymentAccountChannel
  accountTitle  String                @map("account_title") @db.VarChar(150)
  accountNumber String                @map("account_number") @db.VarChar(50)
  bankName      String?               @map("bank_name") @db.VarChar(100)
  iban          String?               @db.VarChar(34)
  instructions  String?               @db.Text // “Send fee + write booking ID in note”
  isActive      Boolean               @default(true) @map("is_active")
  sortOrder     Int                   @default(0) @map("sort_order")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  payments Payment[]

  @@index([isActive, sortOrder])
  @@map("payment_instructions")
}

model Payment {
  id                    String           @id @default(uuid()) @db.Uuid
  payerUserId           String           @map("payer_user_id") @db.Uuid
  payableType           PayableType      @map("payable_type")
  payableId             String           @map("payable_id") @db.Uuid
  amount                Decimal          @db.Decimal(12, 2)
  currency              String           @default("PKR") @db.VarChar(3)
  method                PaymentMethod
  /// Which account was shown for MANUAL_TRANSFER
  paymentInstructionId  String?          @map("payment_instruction_id") @db.Uuid
  /// Optional txn id typed by patient (from JazzCash/bank SMS)
  transferReference     String?          @map("transfer_reference") @db.VarChar(100)
  status                PaymentStatus    @default(INITIATED)
  failureReason         String?          @map("failure_reason") @db.Text
  paidAt                DateTime?        @map("paid_at") @db.Timestamptz()
  verifiedAt            DateTime?        @map("verified_at") @db.Timestamptz()
  idempotencyKey        String?          @unique @map("idempotency_key") @db.VarChar(100)
  meta                  Json?
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  payer               User                @relation("PaymentPayer", fields: [payerUserId], references: [id])
  paymentInstruction  PaymentInstruction? @relation(fields: [paymentInstructionId], references: [id])
  proofs              PaymentProof[]
  refunds             Refund[]

  @@index([payableType, payableId])
  @@index([payerUserId, createdAt])
  @@index([status, createdAt])
  @@index([method, status])
  @@map("payments")
}

/// Screenshot / transfer slip uploaded by patient
model PaymentProof {
  id               String             @id @default(uuid()) @db.Uuid
  paymentId        String             @map("payment_id") @db.Uuid
  storageKey       String             @map("storage_key") @db.VarChar(500)
  fileName         String             @map("file_name") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(100)
  transferReference String?           @map("transfer_reference") @db.VarChar(100)
  amountClaimed    Decimal?           @map("amount_claimed") @db.Decimal(12, 2)
  status           PaymentProofStatus @default(UPLOADED)
  reviewedById     String?            @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz()
  rejectionReason  String?            @map("rejection_reason") @db.Text
  uploadedAt       DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz()

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("PaymentProofReviewer", fields: [reviewedById], references: [id])

  @@index([paymentId, status])
  @@index([status, uploadedAt])
  @@map("payment_proofs")
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?      @db.Text
  status      RefundStatus @default(PENDING)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz()
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

// ─── FUTURE: wallets / ledger / payouts (commission — not used in v1) ────────

/// One wallet per earning entity (doctor / hospital / lab / platform)
model Wallet {
  id           String          @id @default(uuid()) @db.Uuid
  ownerType    LedgerOwnerType @map("owner_type")
  doctorId     String?         @unique @map("doctor_id") @db.Uuid
  hospitalId   String?         @unique @map("hospital_id") @db.Uuid
  labId        String?         @unique @map("lab_id") @db.Uuid
  currency     String          @default("PKR") @db.VarChar(3)
  availableBalance Decimal     @default(0) @map("available_balance") @db.Decimal(14, 2)
  pendingBalance   Decimal     @default(0) @map("pending_balance") @db.Decimal(14, 2)
  lifetimeEarned   Decimal     @default(0) @map("lifetime_earned") @db.Decimal(14, 2)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  doctor   Doctor?       @relation(fields: [doctorId], references: [id])
  hospital Hospital?     @relation(fields: [hospitalId], references: [id])
  lab      Lab?          @relation(fields: [labId], references: [id])
  entries  LedgerEntry[]
  payouts  Payout[]

  @@index([ownerType])
  @@map("wallets")
}

/// Immutable money movement log — source of truth for balances
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(14, 2) // +credit / -debit
  currency      String          @default("PKR") @db.VarChar(3)
  payableType   PayableType?    @map("payable_type")
  payableId     String?         @map("payable_id") @db.Uuid
  payoutId      String?         @map("payout_id") @db.Uuid
  description   String?         @db.VarChar(255)
  idempotencyKey String?        @unique @map("idempotency_key") @db.VarChar(100)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  wallet Wallet  @relation(fields: [walletId], references: [id])
  payout Payout? @relation(fields: [payoutId], references: [id])

  @@index([walletId, createdAt])
  @@index([payableType, payableId])
  @@map("ledger_entries")
}

model PayoutAccount {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  doctorId      String?      @map("doctor_id") @db.Uuid
  method        PayoutMethod
  accountTitle  String       @map("account_title") @db.VarChar(150)
  accountNumber String       @map("account_number") @db.VarChar(50)
  bankName      String?      @map("bank_name") @db.VarChar(100)
  iban          String?      @db.VarChar(34)
  isDefault     Boolean      @default(true) @map("is_default")
  isVerified    Boolean      @default(false) @map("is_verified")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor?  @relation(fields: [doctorId], references: [id])
  payouts Payout[]

  @@index([userId])
  @@map("payout_accounts")
}

model Payout {
  id              String       @id @default(uuid()) @db.Uuid
  walletId        String       @map("wallet_id") @db.Uuid
  payoutAccountId String       @map("payout_account_id") @db.Uuid
  amount          Decimal      @db.Decimal(14, 2)
  currency        String       @default("PKR") @db.VarChar(3)
  status          PayoutStatus @default(PENDING)
  providerRef     String?      @map("provider_ref") @db.VarChar(255)
  failureReason   String?      @map("failure_reason") @db.Text
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz()
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  wallet        Wallet         @relation(fields: [walletId], references: [id])
  payoutAccount PayoutAccount  @relation(fields: [payoutAccountId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([walletId, status])
  @@map("payouts")
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(40)
  type            CouponType
  value           Decimal         @db.Decimal(12, 2) // % or fixed PKR
  appliesTo       CouponAppliesTo @default(ALL) @map("applies_to")
  minOrderAmount  Decimal?        @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount     Decimal?        @map("max_discount") @db.Decimal(12, 2)
  usageLimit      Int?            @map("usage_limit")
  perUserLimit    Int             @default(1) @map("per_user_limit")
  usedCount       Int             @default(0) @map("used_count")
  startsAt        DateTime        @map("starts_at") @db.Timestamptz()
  endsAt          DateTime        @map("ends_at") @db.Timestamptz()
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  appointments Appointment[]
  labOrders    LabOrder[]
  redemptions  CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  labOrderId    String?  @map("lab_order_id") @db.Uuid
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  coupon      Coupon       @relation(fields: [couponId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  labOrder    LabOrder?    @relation(fields: [labOrderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id            String           @id @default(uuid()) @db.Uuid
  patientId     String           @map("patient_id") @db.Uuid
  targetType    ReviewTargetType @map("target_type")
  targetId      String           @map("target_id") @db.Uuid
  appointmentId String?          @map("appointment_id") @db.Uuid
  labOrderId    String?          @map("lab_order_id") @db.Uuid
  rating        Int // 1–5
  comment       String?          @db.Text
  status        ReviewStatus     @default(PUBLISHED)
  moderatedById String?          @map("moderated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  labOrder    LabOrder?    @relation(fields: [labOrderId], references: [id])
  moderatedBy User?        @relation("ReviewModerator", fields: [moderatedById], references: [id])

  @@index([targetType, targetId, status])
  @@index([patientId])
  @@map("reviews")
}

// ─── Platform config & async infra ───────────────────────────────────────────

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_settings")
}

/// Useful keys:
/// - payment_hold_minutes (default 30)
/// - default_slot_minutes
/// - cash_auto_confirm_appointment (bool) — confirm booking immediately on CASH
/// - future: appointment_commission_percent, lab_commission_percent

model NotificationPreference {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  template  String              @db.VarChar(100)
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz()
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model MediaFile {
  id          String       @id @default(uuid()) @db.Uuid
  ownerUserId String?      @map("owner_user_id") @db.Uuid
  ownerType   String       @map("owner_type") @db.VarChar(50)
  ownerId     String       @map("owner_id") @db.Uuid
  storageKey  String       @map("storage_key") @db.VarChar(500)
  mimeType    String       @map("mime_type") @db.VarChar(100)
  byteSize    Int?         @map("byte_size")
  purpose     MediaPurpose @default(OTHER)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@map("media_files")
}

/// Transactional outbox for reliable async (SMS, webhooks, search reindex)
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(100)
  aggregateType String     @map("aggregate_type") @db.VarChar(50)
  aggregateId String       @map("aggregate_id") @db.Uuid
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz()
  publishedAt DateTime?    @map("published_at") @db.Timestamptz()
  lastError   String?      @map("last_error") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
