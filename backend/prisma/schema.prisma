model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  patientId        String            @map("patient_id") @db.Uuid
  /// Who the visit is for (self or family member)
  dependentId      String?           @map("dependent_id") @db.Uuid
  doctorId         String            @map("doctor_id") @db.Uuid
  hospitalId       String?           @map("hospital_id") @db.Uuid
  clinicId         String?           @map("clinic_id") @db.Uuid
  mode             AppointmentMode
  status           AppointmentStatus @default(PENDING_PAYMENT)
  scheduledStart   DateTime          @map("scheduled_start") @db.Timestamptz()
  scheduledEnd     DateTime          @map("scheduled_end") @db.Timestamptz()
  /// Snapshot pricing at booking time
  feeAmount        Decimal           @map("fee_amount") @db.Decimal(12, 2)
  discountAmount   Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  platformFee      Decimal           @default(0) @map("platform_fee") @db.Decimal(12, 2)
  taxAmount        Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency         String            @default("PKR") @db.VarChar(3)
  couponId         String?           @map("coupon_id") @db.Uuid
  /// Hold slot until this time while awaiting payment
  paymentExpiresAt DateTime?         @map("payment_expires_at") @db.Timestamptz()
  /// Follow-up / reschedule chain
  parentAppointmentId String?        @map("parent_appointment_id") @db.Uuid
  rescheduledFromId   String?        @map("rescheduled_from_id") @db.Uuid
  cancelReason     String?           @map("cancel_reason") @db.Text
  cancelledBy      CancelledBy?      @map("cancelled_by")
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz()
  idempotencyKey   String?           @unique @map("idempotency_key") @db.VarChar(100)
  /// SehtDesk calendar sync (NOT_LINKED when doctor has no Desk account)
  syncStatus       DeskSyncStatus    @default(NOT_LINKED) @map("sync_status")
  syncError        String?           @map("sync_error") @db.Text
  syncedAt         DateTime?         @map("synced_at") @db.Timestamptz()
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  patient           Patient                 @relation(fields: [patientId], references: [id])
  dependent         PatientDependent?       @relation(fields: [dependentId], references: [id])
  doctor            Doctor                  @relation(fields: [doctorId], references: [id])
  hospital          Hospital?               @relation(fields: [hospitalId], references: [id])
  clinic            DoctorClinic?           @relation(fields: [clinicId], references: [id])
  coupon            Coupon?                 @relation(fields: [couponId], references: [id])
  parentAppointment Appointment?            @relation("AppointmentFollowUps", fields: [parentAppointmentId], references: [id])
  followUps         Appointment[]           @relation("AppointmentFollowUps")
  rescheduledFrom   Appointment?            @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[]           @relation("AppointmentReschedule")
  consultation      Consultation?
  prescription      Prescription?
  statusHistory     AppointmentStatusHistory[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]

  @@index([doctorId, scheduledStart])
  @@index([patientId, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([scheduledStart])
  @@index([syncStatus])
  @@map("appointments")
}

